# Copie este arquivo para .env e preencha suas chaves
# cp .env.example .env

# === BANCO ===
POSTGRES_USER=avf
POSTGRES_PASSWORD=avf
POSTGRES_DB=avf

# === GERAL ===
TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# URL base da aplicação (para OAuth callbacks)
# APP_BASE_URL=http://localhost:8090
# FRONTEND_URL=http://localhost:3090

# === LLM ===
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# === TTS ===
TTS_PROVIDER=piper
TTS_VOICE=es_ES-mls_10246-low
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
ELEVENLABS_API_KEY=

# === VÍDEO ===
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SECONDS=30
VIDEO_RENDER_MODE=template

# === TIKTOK DEVELOPER API ===
# Criar app em: https://developers.tiktok.com/
# Habilitar: Login Kit + Content Posting API
# Adicionar redirect URI: http://localhost:8090/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# === IMAGENS ===
# Serper.dev — Google Images API (100 buscas/mês grátis): https://serper.dev
SERPER_API_KEY=

# === RENDERERS (IA Generativa) ===
RUNWAY_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=
